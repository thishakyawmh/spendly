# Required backend environment variables
DATABASE_URL=postgresql://user:password@host/database
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Upstash Redis (required by the rate limiter)
UPSTASH_REDIS_REST_URL=https://replace-with-your-upstash-url
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
